# AgentShield environment. Copy this file to .env (gitignored).
# `make run` sources .env. `docker compose` substitutes the same keys.
# Both values may stay empty: the gateway then runs offline.
# mock/vulnerable-llm needs no network, and the audit HMAC key is created
# at data/audit.key on first start.

# Credential for the semantic judge and openrouter/* models.
# policy.yaml semantic.api_key_env is OPENROUTER_API_KEY.
OPENROUTER_API_KEY=

# HMAC-SHA256 key for the audit chain (backend/app/engine.py).
# Leave this empty to generate data/audit.key.
# Set it before the first request if `make verify-audit` and container
# restarts must accept an existing data/audit.jsonl. Rotating the key
# makes that chain fail HMAC verification.
# Use one token with no spaces and no quotes.
AGENTSHIELD_AUDIT_KEY=

# Required for console APIs, policy editing, approvals, audit exports, and metrics.
# Set a random token (e.g. openssl rand -hex 32), then enter it in console Settings.
# Without a token, admin endpoints are disabled. Agent APIs still require agent keys.
AGENTSHIELD_ADMIN_TOKEN=
